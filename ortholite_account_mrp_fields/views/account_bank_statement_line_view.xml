<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_statement_line_tree_bank_rec_widget_inherit_ortholite" model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_accountant.view_bank_statement_line_tree_bank_rec_widget"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="usd_amount"/>
            </xpath>
            <xpath expr="//field[@name='running_balance']" position="after">
                <field name="usd_running_balance"/>
            </xpath>
        </field>
    </record>
</odoo>