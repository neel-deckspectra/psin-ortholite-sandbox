<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_ortholite_account" model="ir.ui.view">
        <field name="name">res.config.settings.ortholite</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='fiscalyear']" position="after">
                <setting id="accounting_lock_dates" string="Allow to Lock Accounting Transactions (Monthly)">
                    <field name="is_accounting_lock_day" widget="upgrade_boolean"/>
                    <div id="fiscalyear_last_day_id" class="content-group" invisible="not is_accounting_lock_day">
                        <div class="d-flex mt16 align-items-baseline">
                            <label for="lock_day" string="Monthly Locking Day" class="col-lg-3 o_light_label pe-2 pe-lg-0"/>
                            <div class="col-lg-9">
                                <field name="lock_day"/>
                            </div>
                        </div>
                        <div class="d-flex mt16 align-items-baseline">
                            <label for="lock_date_allow_user_ids" string="Allow Users" class="col-lg-3 o_light_label pe-2 pe-lg-0"/>
                            <div class="col-lg-9">
                                <field name="lock_date_allow_user_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
