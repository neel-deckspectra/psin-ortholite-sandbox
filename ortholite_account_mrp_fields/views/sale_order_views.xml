<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_ortholite" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.ortholite</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="string">Brand</attribute>
            </xpath>
        </field>
    </record>
    <record id="sale_order_tree_inherit_ortholite" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.ortholite</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_ids']" position="after">
                <field name="product_category"/>
            </xpath>
        </field>
    </record>
</odoo>
