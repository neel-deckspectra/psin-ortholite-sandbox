<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_form_view_inherit_ortholite" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.ortholite</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="partner_id"/>
            </xpath>
            <xpath expr="//div[@name='bom_div']" position="after">
                <field name="brand_ids" widget="many2many_tags"/>
                <field name="delivery_date"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_tree_view_inherit_ortholite" model="ir.ui.view">
        <field name="name">mrp.production.tree.inherit.ortholite</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="partner_id"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="brand_ids" widget="many2many_tags"/>
                <field name="delivery_date"/>
            </xpath>
        </field>
    </record>

</odoo>
