<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_asset_form_inherit_ortholite" model="ir.ui.view">
        <field name="name">account.asset.form.ortholite</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <group>
                        <field name="qr_code" invisible="1"/>
                        <field name="sr_number" required="1" invisible="state == 'model'"/>
                        <field name="workcenter_id" required="1" invisible="state == 'model'" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group>
                    </group>
                </group>
            </xpath>
            <xpath expr="//button[@name='open_entries']" position="after">
                <button class="oe_stat_button" name="open_equipment" type="object" icon="fa-cubes">
                    <field string="Equipment" name="equipment_count" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='method']" position="before">
                <field name="code" invisible="not state == 'model'"/>
            </xpath>
            <xpath expr="//field[@name='analytic_distribution']" position="attributes">
                <attribute name="required">state != 'model'</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_equipment_view_form_inherit_ortholite" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.ortholite</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="account_asset_id"/>
            </xpath>
            <xpath expr="//field[@name='location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='workcenter_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True,'no_open': True}</attribute>
                <attribute name="string">Location</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_equipment_request_view_form_inherit_ortholite" model="ir.ui.view">
        <field name="name">maintenance.request.form</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='equipment_id']" position="after">
                <field name="vendor_bill_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_ortholite_maintenance_request" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_open_maintenance_request" type="object" icon="fa-wrench" invisible="maintenance_request_count == 0 or move_type != 'in_invoice'">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="maintenance_request_count"/></span>
                        <span class="o_stat_text">Maintenance Requests</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="maintenance_request_count" invisible="1"/>
                <field name="maintenance_request_ids" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
