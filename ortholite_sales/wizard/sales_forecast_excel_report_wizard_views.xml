<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sales_forecast_excel_report_wizard_form_views" model="ir.ui.view">
        <field name="name">sales.forecast.excel.report.wizard</field>
        <field name="model">sales.forecast.excel.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Forecast Summary">
                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="product_attribute_value_id" options="{'no_create': True, 'no_edit': True}" context="{'brand_attribute_value': True}"/>
                    </group>
                    <group>
                        <field name="end_date"/>
                        <field name="category_id"/>
                    </group>
                </group>
                <footer>
                    <button name="print_xls_report" string="Download" class="oe_highlight" type="object" icon="fa-file-excel-o" />
                    or
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sales_forecast_excel_report_wizard" model="ir.actions.act_window">
        <field name="name">Forecast Summary</field>
        <field name="res_model">sales.forecast.excel.report.wizard</field>
        <field name="view_id" ref="ortholite_sales.sales_forecast_excel_report_wizard_form_views" />
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_sales_forecast_excel_report_wizard"
        name="Forecast Summary"
        parent="crm.crm_menu_report"
        action="ortholite_sales.action_sales_forecast_excel_report_wizard"
        sequence="10"
    />
    
</odoo>
