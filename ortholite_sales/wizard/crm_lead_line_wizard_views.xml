<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_wizard_wizard_form_view" model="ir.ui.view">
        <field name="name">crm.lead.wizard.form.view</field>
        <field name="model">crm.lead.wizard</field>
        <field name="arch" type="xml">
            <form string="Create New Quotation">
                <notebook>
                    <page name="products" string="Product Details">
                        <field name="opportunity_type" invisible="1"/>
                        <field name="lead_line_ids">
                            <tree editable="bottom" create="0">
                                <field name="lead_id" column_invisible="True"/>
                                <field name="product_id" string="Product" options="{'no_create': True, 'no_edit': True, 'no_open': True}" readonly="1"/>
                                <field name="fc_date" readonly="1" column_invisible="not parent.opportunity_type == 'forecast'"/>
                                <field name="product_attribute_value_id" options="{'no_create': True, 'no_edit': True}" readonly="1"/>
                                <field name="category_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" readonly="1"/>
                                <field name="forecasted_qty" readonly="1"/>
                                <field name="order_qty" readonly="1"/>
                                <field name="new_qty"/>
                                <field name="price_unit" readonly="1"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Create Quotation" name="action_create_quotation" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>