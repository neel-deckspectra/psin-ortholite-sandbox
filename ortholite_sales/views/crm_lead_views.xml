<?xml version="1.0" ?>
<odoo>
    <record id="crm_lead_view_form_inherit_ortholite_sales_forecast_excel_report" model="ir.ui.view">
        <field name="name">crm.lead.form - ortholite - forecast report</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='lead_partner']//field[@name='partner_id']" position="before">
                <field name="opportunity_type" required="1"/>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']//field[@name='partner_id']" position="before">
                <field name="opportunity_type" required="1"/>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="fc_type" invisible="type == 'lead' or opportunity_type in ('direct', 'new_opportunity')" options="{'no_create': True, 'no_edit': True}"/>
                <field name="season_id" required="opportunity_type ==  'forecast'" invisible="type == 'lead' or opportunity_type in ('direct', 'new_opportunity')" options="{'no_create': True, 'no_edit': True}"/>
                <field name="customer_group_id" invisible="type == 'lead' or opportunity_type in ('direct', 'new_opportunity')" options="{'no_create': True, 'no_edit': True}" domain="[('is_customer_group', '=', True)]"/>
            </xpath>
            <xpath expr="//group[@name='lead_priority']//field[@name='tag_ids']" position="after">
                <field name="fc_type" invisible="type == 'opportunity' or opportunity_type in ('direct', 'new_opportunity')"/>
                <field name="season_id" required="opportunity_type ==  'forecast'" invisible="type == 'opportunity' or opportunity_type in ('direct', 'new_opportunity')" options="{'no_create': True, 'no_edit': True}"/>
                <field name="customer_group_id" invisible="type == 'opportunity' or opportunity_type in ('direct', 'new_opportunity')" options="{'no_create': True, 'no_edit': True}" domain="[('is_customer_group', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_form_inherit_ortholite" model="ir.ui.view">
        <field name="name">crm.lead.form - ortholite</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm_lead_product.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='products']" position="replace">
                <page name="products" string="Product Details" invisible="type == 'lead'">
                    <field name="lead_line_ids" widget="section_and_note_one2many" mode="tree" context="{'default_display_type': False}">
                        <tree editable="bottom">
                            <control>
                               <create name="add_product_control" string="Add a product"/>
                               <create name="add_section_control" string="Add a section" context="{'default_display_type': 'line_section'}"/>
                               <create name="add_note_control" string="Add a note" context="{'default_display_type': 'line_note'}"/>
                            </control>
                            <field name="display_type" column_invisible="True"/>
                            <field name="product_id" required="not display_type" string="Product" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="name"/>
                            <field name="fc_date" column_invisible="not parent.opportunity_type == 'forecast'" required="parent.opportunity_type == 'forecast'"/>
                            <field name="product_attribute_value_id" options="{'no_create': True, 'no_edit': True}" readonly="1" force_save="1"/>
                            <field name="category_id" options="{'no_create': True, 'no_edit': True}" readonly="1" force_save="1"/>
                            <field name="product_qty" required="not display_type" string="Quantity"/>
                            <field name="order_qty"/>
                            <field name="uom_id" options="{'no_create': True, 'no_edit': True}" force_save="1" string="UoM"/>
                            <field name="price_unit" string="Unit Price"/>
                            <field name="expected_revenue" string="Expected Revenue"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="crm_case_kanban_view_leads_inehrit_ortholite_sales" model="ir.ui.view">
        <field name="name">crm.lead.kanban</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="before">
                <field name="opportunity_type"/>
            </xpath>
        </field>
    </record>

    <record id="quick_create_opportunity_form_inehrit_ortholite_sales" model="ir.ui.view">
        <field name="name">crm.lead.quick_create</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="opportunity_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_inherit_ortholite_sales_forecast_excel_report" model="ir.ui.view">
        <field name="name">res.partner - ortholite - forecast report</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_type']" position="after">
                <span>Is a Customer Group ?
                    <field name="is_customer_group" widget="boolean_toggle"/>
                </span>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]" position="after">
                <field name="code" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='mobile']" position="replace">
                <div class="o_row">
                    <span style="width: 50px !important;"><field name="phone_code" placeholder="Code"/></span>
                    <field name="mobile" class="oe_inline" placeholder="mobile"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
