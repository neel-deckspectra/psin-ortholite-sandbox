<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_category_view_form_inherit_ds_ortholite_approvals" model="ir.ui.view">
        <field name="name">approval.category.view.form</field>
        <field name="model">approval.category</field>
        <field name="inherit_id" ref="approvals.approval_category_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page/group/group[@name='option_settings']" position="attributes">
                <attribute name="invisible">approval_type in ['bom', 'product', 'customer']</attribute>
            </xpath>
        </field>
    </record>
    <record id="approval_request_view_form_inherit_ds_ortholite_approval" model="ir.ui.view">
        <field name="name">approval.request.view.form</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_confirmed']" position="after">
                <field name="bom_id" invisible="approval_type != 'bom'" readonly="1" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                <field name="template_id" readonly="1" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" invisible="approval_type != 'product'"/>
                <field name="categ_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" invisible="approval_type != 'product'" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="approval_category_view_kanban_inherit_ds_ortholite_approval" model="ir.ui.view">
        <field name="name">approval.category.views.kanban</field>
        <field name="model">approval.category</field>
        <field name="inherit_id" ref="approvals.approval_category_view_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='create_request']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="mrp_bom_form_view_inherit_ds_ortholite_approvals" model="ir.ui.view">
        <field name="name">mrp.bom.form</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//form//sheet" position="before">
                <header>
                    <field name="request_status" widget="statusbar" invisible="'request_status' == False or approval_active == False"/>
                    <field name="approval_active" invisible="1" />
                    <field name="user_status" invisible="1" />
                    <field name="has_access_to_request" invisible="1" />
                    <button name="approval_action_confirm" string="Submit" type="object" invisible="request_status != 'new' or approval_active == False" class="btn-primary" data-hotkey="v" />
                    <button name="approval_action_approve" string="Approve" type="object" invisible="user_status != 'pending' or approval_active == False" data-hotkey="q"/>
                    <button name="approval_action_refuse" string="Refuse" type="object" invisible="user_status != 'pending' or approval_active  == False" data-hotkey="x" />
                    <button name="approval_action_withdraw" string="Withdraw" type="object" invisible="request_status == 'new' or user_status in ['pending', 'cancel'] or user_status == False or approval_active == False" data-hotkey="y" />
                    <button name="approval_action_draft" string="Back To Draft" type="object" invisible="request_status != 'cancel' or approval_active == False and user_status == False or has_access_to_request == False" data-hotkey="w" />
                    <button name="approval_action_cancel" string="Cancel" type="object" invisible="request_status in ['new', 'cancel'] or approval_active == False and user_status == False or has_access_to_request == False" data-hotkey="z" />
                </header>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('company_id', 'in', [False, company_id]),('request_status', '=', 'approved'),('product_tmpl_id', '=', product_tmpl_id), ('is_fg_product', '=', True)]</attribute>
                <attribute name="readonly">user_status == 'approved'</attribute>
                <attribute name="options">{'no_create': True, 'no_edit': True,'no_open': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='product_tmpl_id']" position="attributes">
                <attribute name="domain">[('company_id', 'in', [False, company_id]),('request_status', '=', 'approved'),('type', 'in', ['product', 'consu']), ('is_fg_product', '=', True)]</attribute>
                <attribute name="readonly">user_status == 'approved'</attribute>
                <attribute name="options">{'no_create': True, 'no_edit': True,'no_open': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='type']" position="attributes">
                <attribute name="readonly">user_status == 'approved'</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_line_ids']" position="attributes">
                <attribute name="readonly">user_status == 'approved'</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_line_ids']//tree//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True,'no_open': True}</attribute>
                <attribute name="domain">[('categ_id', '=', product_categ_id),('request_status', '=', 'approved')]</attribute>
            </xpath>
            <xpath expr="//field[@name='bom_line_ids']//tree//field[@name='product_categ_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True,'no_open': True}</attribute>
            </xpath>
        </field>
    </record>
    <record id="product_template_form_view_inherit_ds_ortholite_approvals" model="ir.ui.view">
        <field name="name">product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="request_status" widget="statusbar" invisible="'request_status' == False or approval_active == False"/>
                <field name="approval_active" invisible="1" />
                <field name="user_status" invisible="1" />
                <field name="has_access_to_request" invisible="1" />
                <button name="approval_action_confirm" string="Submit" type="object" invisible="request_status != 'new' or approval_active == False" class="btn-primary" data-hotkey="v" />
                <button name="approval_action_approve" string="Approve" type="object" invisible="user_status != 'pending' or approval_active == False" data-hotkey="q"/>
                <button name="approval_action_refuse" string="Refuse" type="object" invisible="user_status != 'pending' or approval_active  == False" data-hotkey="x" />
                <button name="approval_action_withdraw" string="Withdraw" type="object" invisible="request_status == 'new' or user_status in ['pending', 'cancel'] or user_status == False or approval_active == False" data-hotkey="y" />
                <button name="approval_action_draft" string="Back To Draft" type="object" invisible="request_status != 'cancel' or approval_active == False and user_status == False or has_access_to_request == False" data-hotkey="w" />
                <button name="approval_action_cancel" string="Cancel" type="object" invisible="request_status in ['new', 'cancel'] or approval_active == False and user_status == False or has_access_to_request == False" data-hotkey="z" />
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">user_status == 'approved'</attribute>
            </xpath>
            <xpath expr="//field[@name='detailed_type']" position="attributes">
                <attribute name="readonly">user_status == 'approved'</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_policy']" position="attributes">
                <attribute name="readonly">user_status == 'approved'</attribute>
            </xpath>
            <xpath expr="//field[@name='uom_id']" position="attributes">
                <attribute name="readonly">user_status == 'approved'</attribute>
            </xpath>
            <xpath expr="//field[@name='uom_po_id']" position="attributes">
                <attribute name="readonly">user_status == 'approved'</attribute>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="attributes">
                <attribute name="readonly">user_status == 'approved'</attribute>
            </xpath>
            <xpath expr="//field[@name='l10n_in_hsn_code']" position="attributes">
                <attribute name="readonly">user_status == 'approved'</attribute>
            </xpath>
            <xpath expr="//field[@name='route_ids']" position="attributes">
                <attribute name="readonly">user_status == 'approved'</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_ok']" position="attributes">
