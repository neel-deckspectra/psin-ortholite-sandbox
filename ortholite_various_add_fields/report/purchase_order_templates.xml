<odoo>
    <data>
        <template id="report_purchaseorder_document_inherit_ortholite" inherit_id="purchase.report_purchaseorder_document">
            <xpath expr="//div[@t-elif='o.date_order']" position="after">
                <div t-if="o.payment_term_id" class="col-3 bm-2">
                    <strong>Payment Terms:</strong>
                    <p t-field="o.payment_term_id"/>
                </div>
            </xpath>
        </template>
    </data>
</odoo>