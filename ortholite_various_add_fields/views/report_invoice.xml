<odoo>
    <data>

    <template id="report_invoice_document_ortholite" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th name="th_product_categ" class="text-end">Product Category</th>
        </xpath>
        <xpath expr="//td[@name='td_quantity']" position="after">
            <td name="td_product_categ" class="text-end">
                <span t-field="line.product_categ_id"/>
            </td>
        </xpath>
    </template>

    </data>
</odoo>
