<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="product_category_form_view_inherit_ortholite_various_add_fields" model="ir.ui.view">
        <field name="name">product.category.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="before">
                <group>
                    <group>
                        <field name="code"/>
                    </group>
                    <group>
                        <field name="attributes_ids" widget="many2many_tags"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_category_list_view_inherit_ortholite_various_add_fields" model="ir.ui.view">
        <field name="name">product.category.tree</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="code"/>
                <field name="attributes_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
