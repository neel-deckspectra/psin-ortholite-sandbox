<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_form_inherit_ortholite_various_add_fields" model="ir.ui.view">
        <field name="name">purchase.request.form</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(purchase_request.action_purchase_request_line_make_purchase_order)d']" position="attributes">
                <attribute name="groups">purchase.group_purchase_user</attribute>
            </xpath>
            <xpath expr="//field[@name='requested_by']" position="attributes">
                <attribute name="domain">[('groups_id', '=', %(purchase_request.group_purchase_request_user)d)]</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']//tree//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_edit': True,'no_open': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>