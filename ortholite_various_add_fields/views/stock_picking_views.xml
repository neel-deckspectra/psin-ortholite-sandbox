<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="view_picking_form_inherit_ortholite" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.ortholite</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_categ_id"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="ortholite_delivery_type" readonly="state == 'done'" invisible="picking_type_code == 'incoming'"/>
                <field name="ortholite_issue" readonly="state == 'done'" invisible="picking_type_code == 'incoming'"/>
                <field name="po_received_date" readonly="1" invisible="picking_type_code != 'incoming'"/>
                <field name="grn_sequence" readonly="1" invisible="picking_type_code != 'incoming'"/>
            </xpath>
            <xpath expr="//button[@name='button_validate'][hasclass('o_btn_validate')]" position="before">
                <button string="Receive PO" name="set_po_received_date" type="object" class="oe_highlight" invisible="state == 'done' or po_received_date or picking_type_code != 'incoming'"/>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_inherit_ortholite_various_add_fields" model="ir.ui.view">
        <field name="name">stock.picking.tree</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="picking_type_code"/>
                <field name="ortholite_issue"/>
                <field name="po_received_date"/>
                <field name="grn_sequence"/>
                <field name="sale_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_internal_search_inherit_ortholite_various_add_fields" model="ir.ui.view">
        <field name="name">stock.picking.search</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="grn_sequence"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_inherit_ortholite_various_add_fields" model="ir.ui.view">
        <field name="name">stock.move.line.tree</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expiration_date']" position="before">
                <field name="invoice_date"/>
            </xpath>
        </field>
    </record>
</odoo>
