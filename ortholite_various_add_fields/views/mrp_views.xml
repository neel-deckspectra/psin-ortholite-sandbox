<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="mrp_production_form_view_inherit_ortholite" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.ortholite</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']/tree/field[@name='product_id']" position="after">
                <field name="product_categ_id"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_bom_form_view_inherit_ortholite" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.ortholite</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/tree/field[@name='product_id']" position="before">
                <field name="product_categ_id" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='bom_line_ids']/tree/field[@name='product_id']" position="attributes">
                <attribute name="domain">[('categ_id', '=', product_categ_id)]</attribute>
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
