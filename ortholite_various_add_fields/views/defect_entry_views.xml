<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="defect_entry_tree_views" model="ir.ui.view">
        <field name="name">defect.entry.tree</field>
        <field name="model">defect.entry</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="datetime" required="1"/>
                <field name="sale_order_id" required="1" domain="[('state','=','sale')]"/>
                <field name="product_id" required="1" context="{'defect_entry_so_id': sale_order_id}"/>
                <field name="product_category_id" required="1"/>
                <field name="defect_section_id" required="1"/>
                <field name="defect_library_id" required="1"/>
                <field name="quantity"/>
                <field name="product_uom" required="1"/>
            </tree>
        </field>
    </record>

    <record id="action_defect_entry" model="ir.actions.act_window">
        <field name="name">Defect Entry</field>
        <field name="res_model">defect.entry</field>
        <field name='view_mode'>tree</field>
        <field name='view_id' ref='defect_entry_tree_views'/>
        <field name="binding_model_id" ref="model_defect_entry"/>
    </record>

    <menuitem id="menu_defect_entry"
        name="Defect Entry"
        parent="quality_control.quality_control_menu_product"
        action="ortholite_various_add_fields.action_defect_entry"
        sequence="16"
    />

    <record id="defect_library_tree_views" model="ir.ui.view">
        <field name="name">defect.library.tree</field>
        <field name="model">defect.library</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name" required="1"/>
            </tree>
        </field>
    </record>

    <record id="action_defect_library" model="ir.actions.act_window">
        <field name="name">Defect Library</field>
        <field name="res_model">defect.library</field>
        <field name='view_mode'>tree</field>
        <field name='view_id' ref='defect_library_tree_views'/>
        <field name="binding_model_id" ref="model_defect_library"/>
    </record>

    <menuitem id="menu_defect_library"
        name="Defect Library"
        parent="quality_control.menu_quality_configuration"
        action="ortholite_various_add_fields.action_defect_library"
        sequence="25"
    />

    <record id="defect_section_tree_views" model="ir.ui.view">
        <field name="name">defect.section.tree</field>
        <field name="model">defect.section</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name" required="1"/>
            </tree>
        </field>
    </record>

    <record id="action_defect_section" model="ir.actions.act_window">
        <field name="name">Defect Section</field>
        <field name="res_model">defect.section</field>
        <field name='view_mode'>tree</field>
        <field name='view_id' ref='defect_section_tree_views'/>
        <field name="binding_model_id" ref="model_defect_section"/>
    </record>

    <menuitem id="menu_defect_section"
        name="Defect Section"
        parent="quality_control.menu_quality_configuration"
        action="ortholite_various_add_fields.action_defect_section"
        sequence="26"
    />

</odoo>
