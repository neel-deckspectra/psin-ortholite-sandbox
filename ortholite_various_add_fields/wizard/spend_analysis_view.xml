<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_spend_analysis_wizard_form" model="ir.ui.view">
        <field name="name">spend.analysis.wizard.form</field>
        <field name="model">spend.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Spend Analysis Wizard">
            <group>    
                <group>
                    <field name="start_date"/>
                    <field name="vendor"/>
                    <field name="product_categ_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <group>
                    <field name="end_date"/>
                    <field name="vendor_category_id" options="{'no_create': True, 'no_open': True}"/> 
                </group>
            </group>

                <footer>
                    <button string="Download" type="object" name="print_xls_report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_spend_analysis_wizard" model="ir.actions.act_window">
        <field name="name">Spend Analysis</field>
        <field name="res_model">spend.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_spend_analysis_wizard" 
    name="Spend Analysis" 
    parent="stock.menu_warehouse_report" 
    sequence="315" 
    action="ortholite_various_add_fields.action_spend_analysis_wizard"/>

</odoo>
