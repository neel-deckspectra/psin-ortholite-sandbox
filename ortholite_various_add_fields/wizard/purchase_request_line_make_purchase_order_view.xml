<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_purchase_request_line_make_purchase_order_inherit_ortholite" model="ir.ui.view">
        <field name="name">Purchase Request Line Make Purchase Order</field>
        <field name="model">purchase.request.line.make.purchase.order</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_line_make_purchase_order"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='item_ids']/tree/field[@name='keep_description']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='item_ids']/tree/field[@name='request_id']" position="before">
                <field name="keep_description" string="Select Product"/>
            </xpath>
        </field>
    </record>
</odoo>
