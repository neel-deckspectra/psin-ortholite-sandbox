<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="open_grn_picking_report_wizard_form_views" model="ir.ui.view">
        <field name="name">grn.picking.report.wizard.form</field>
        <field name="model">grn.picking.report.wizard</field>
        <field name="arch" type="xml">
            <form string="GRN">
                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="product_categ_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="end_date"/>
                        <field name="partner_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="print_xls_report" string="Download" class="oe_highlight" type="object" icon="fa-file-excel-o" />
                    or
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_open_grn_picking_report_wizard" model="ir.actions.act_window">
        <field name="name">GRN</field>
        <field name="res_model">grn.picking.report.wizard</field>
        <field name="view_id" ref="ortholite_various_add_fields.open_grn_picking_report_wizard_form_views" />
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_open_grn_report_wizard"
        name="GRN"
        parent="stock.menu_warehouse_report"
        action="ortholite_various_add_fields.action_open_grn_picking_report_wizard"
        sequence="300"
    />
    
</odoo>