<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_form_view" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//form//sheet" position="before">
                <header>
                    <field name="request_status" widget="statusbar" invisible="'request_status' == False or approval_active == False"/>
                    <field name="approval_active" invisible="1" />
                    <field name="user_status" invisible="1" />
                    <field name="has_access_to_request" invisible="1" />
                    <button name="approval_action_confirm" string="Submit" type="object" invisible="request_status != 'new' or approval_active == False" class="btn-primary" data-hotkey="v" />
                    <button name="approval_action_approve" string="Approve" type="object" invisible="user_status != 'pending' or approval_active == False" data-hotkey="q"/>
                    <button name="approval_action_refuse" string="Refuse" type="object" invisible="user_status != 'pending' or approval_active  == False" data-hotkey="x" />
                    <button name="approval_action_withdraw" string="Withdraw" type="object" invisible="request_status == 'new' or user_status in ['pending', 'cancel'] or user_status == False or approval_active == False" data-hotkey="y" />
                    <button name="approval_action_draft" string="Back To Draft" type="object" invisible="request_status != 'cancel' or approval_active == False and user_status == False or has_access_to_request == False" data-hotkey="w" />
                    <button name="approval_action_cancel" string="Cancel" type="object" invisible="request_status in ['new', 'cancel'] or approval_active == False and user_status == False or has_access_to_request == False" data-hotkey="z" />
                </header>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]" position="after">
                <field name="contacts_type" required="0"/>
            </xpath>
        </field>
    </record>
</odoo>