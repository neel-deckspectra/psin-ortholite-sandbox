<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_category_view_form_customer" model="ir.ui.view">
        <field name="name">approval.category.view.form</field>
        <field name="model">approval.category</field>
        <field name="inherit_id" ref="approvals.approval_category_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='approval_type']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//notebook/page/group/group[@name='option_settings']" position="attributes">
                <attribute name="invisible">approval_type == 'customer'</attribute>
            </xpath>
        </field>
    </record>
</odoo>  