<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="to_invoice_bill_orders_report_wizard_form_views" model="ir.ui.view">
        <field name="name">to.invoice.bill.orders.report.wizard</field>
        <field name="model">to.invoice.bill.orders.report.wizard</field>
        <field name="arch" type="xml">
            <form string="To Invoice/Bill Orders">
                <group>
                    <group>
                        <field name="month"/>
                        <field name="type" widget="radio"/>
                    </group>
                    <group>
                        <field name="year"/>
                    </group>
                </group>
                <footer>
                    <button name="print_xls_report" string="Download" class="oe_highlight" type="object" icon="fa-file-excel-o" />
                    or
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_to_invoice_bill_orders_report_wizard" model="ir.actions.act_window">
        <field name="name">To Invoice/Bill Orders</field>
        <field name="res_model">to.invoice.bill.orders.report.wizard</field>
        <field name="view_id" ref="ortholite_account_reports.to_invoice_bill_orders_report_wizard_form_views" />
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_to_invoice_bill_orders_report_wizard"
        name="To Invoice/Bill Orders"
        parent="account.menu_finance_reports"
        action="ortholite_account_reports.action_to_invoice_bill_orders_report_wizard"
        sequence="202"
    />
    
</odoo>