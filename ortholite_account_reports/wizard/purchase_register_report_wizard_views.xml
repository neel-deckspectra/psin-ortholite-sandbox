<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_register_report_wizard_form_views" model="ir.ui.view">
        <field name="name">purchase.register.report.wizard</field>
        <field name="model">purchase.register.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Register">
                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="product_categ_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="end_date"/>
                    </group>
                </group>
                <footer>
                    <button name="print_xls_report" string="Download" class="oe_highlight" type="object" icon="fa-file-excel-o" />
                    or
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_register_report_wizard" model="ir.actions.act_window">
        <field name="name">Purchase Register</field>
        <field name="res_model">purchase.register.report.wizard</field>
        <field name="view_id" ref="ortholite_account_reports.purchase_register_report_wizard_form_views" />
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_purchase_register_report_wizard"
        name="Purchase Register"
        parent="account.menu_finance_reports"
        action="ortholite_account_reports.action_purchase_register_report_wizard"
        sequence="200"
    />
    
</odoo>