<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ortholite_account_reports" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="advance_license_number" invisible="move_type != 'in_invoice'"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="after">
                <field name="duty_bcd_inr" column_invisible="parent.move_type != 'in_invoice'" optional="show"/>
                <field name="freight" column_invisible="parent.move_type != 'in_invoice'" optional="show"/>
                <field name="insurance" column_invisible="parent.move_type != 'in_invoice'" optional="show"/>
                <field name="clearingcharge" column_invisible="parent.move_type != 'in_invoice'" optional="show"/>
                <field name="liner_charges" column_invisible="parent.move_type != 'in_invoice'" optional="show"/>
                <field name="aai_charges" column_invisible="parent.move_type != 'in_invoice'" optional="show"/>
                <field name="cfs_charges" column_invisible="parent.move_type != 'in_invoice'" optional="show"/>
                <field name="inland_transport" column_invisible="parent.move_type != 'in_invoice'" optional="show"/>
                <field name="fine_amt" column_invisible="parent.move_type != 'in_invoice'" optional="show"/>
                <field name="int_charges" column_invisible="parent.move_type != 'in_invoice'" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
