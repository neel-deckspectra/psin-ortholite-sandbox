<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sample_tracking_report_wizard_form_views" model="ir.ui.view">
        <field name="name">sample.tracking.report.wizard</field>
        <field name="model">sample.tracking.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Sample Tracking">
                <group>
                    <group>
                        <field name="start_date"/>
                    </group>
                    <group>
                        <field name="end_date"/>
                    </group>
                </group>
                <footer>
                    <button name="print_xls_report" string="Download" class="oe_highlight" type="object" icon="fa-file-excel-o" />
                    or
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sample_tracking_report_wizard" model="ir.actions.act_window">
        <field name="name">Sample Tracking</field>
        <field name="res_model">sample.tracking.report.wizard</field>
        <field name="view_id" ref="ortholite_crm_plm.sample_tracking_report_wizard_form_views" />
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_sample_tracking_report_wizard"
        name="Sample Tracking"
        parent="mrp_plm.menu_mrp_plm_reporting"
        action="ortholite_crm_plm.action_sample_tracking_report_wizard"
        sequence="201"
    />
    
</odoo>