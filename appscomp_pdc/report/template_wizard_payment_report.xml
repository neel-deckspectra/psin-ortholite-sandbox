<odoo>
    <template id="template_pdc_payment_qweb">
        <t t-call="web.html_container">
            <t>
                <t t-call="web.basic_layout">
                    <br/>
                    <div class="header">
                        <div class="row">
                            <div class="col-8" align="left">
                                <img src='/web/binary/company_logo' class="img-fluid img-thumbnail" align="left"
                                     style="height:120pt;width:120pt;"/>
                                <!--                        <hr style="color:blue; border-top:2px solid #76d0f9; margin-top:1px"/>-->
                            </div>
                            <div class="col-4" align="right">
                                <strong>
                                    <span t-field="res_company.partner_id.name"/>
                                </strong>
                                <br/>
                                <span t-field="res_company.partner_id.street"/>
                                <span t-field="res_company.partner_id.street2"/>,
                                <br/>
                                <span t-field="res_company.partner_id.city"/>
                                <span t-field="res_company.partner_id.state_id.name"/>
                                <span t-field="res_company.partner_id.country_id.name"/>
                                <br/>
                                <span t-field="res_company.partner_id.phone"/>
                            </div>
                        </div>
                    </div>
                    <br/>
                    <br/>
                    <div class="page">
                        <br/>
                        <div align="center" style="font-size: 20px;background-color:lavenderblush;">
                            <h2>
                                <strong>PDC Payment Report</strong>
                            </h2>
                        </div>
                        <br/>
                        <br/>
                        <div class="row" style="font-size: 20px;">
                            <div class="col-9">
                                <strong class="px-2"></strong>
                                <strong class="px-2">Report Date</strong>
                                <strong class="px-2">:</strong>
                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/>
                                <strong class="px-2"></strong>
                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%H:%M:%S')"/>
                            </div>
                            <div>
                                <strong class="px-2">Generated By</strong>
                                <strong class="px-2">:</strong>
                                <t t-foreach="user_name" t-as="d">
                                    <td>
                                        <span t-esc="d"/>
                                    </td>
                                </t>
                            </div>
                        </div>
                        <br/>
                        <br/>
                        <div class="row">
                            <table class="table table-sm table-bordered"
                                   style="border:1px solid black;font-size: 20px;">
                                <thead class="thead-light">
                                    <tr style="background-color:#18449B;;">
                                        <th class="text-center bg-secondary text-white"
                                            style="width: 3%;font-weight:bold">Sl.No.
                                        </th>
                                        <th class="text-center bg-secondary text-white"
                                            style="width: 8%;font-weight:bold">PDC Number
                                        </th>
                                        <th class="text-center bg-secondary text-white"
                                            style="width: 8%;font-weight:bold">Due Date
                                        </th>
                                        <th class="text-center bg-secondary text-white"
                                            style="width: 8%;font-weight:bold">Customer
                                        </th>
                                        <th class="text-center bg-secondary text-white"
                                            style="width: 10%;font-weight:bold">Amount
                                        </th>
                                        <th class="text-center bg-secondary text-white"
                                            style="width: 8%;font-weight:bold">Cheque Ref
                                        </th>
                                        <th class="text-center bg-secondary text-white"
                                            style="width: 8%;font-weight:bold">Journal
                                        </th>
                                        <th class="text-center bg-secondary text-white"
                                            style="width: 8%;font-weight:bold">Customer Invoice
                                        </th>
                                        <th class="text-center bg-secondary text-white"
                                            style="width: 8%;font-weight:bold">Status
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="docs" t-as="d">
                                        <tr>
                                            <td width="3%" class="padding_all tbottom ttop text-center">
                                                <span t-esc="d_index+1"/>
                                            </td>
                                            <t>
                                                <t t-if="d['name']">
                                                    <td>
                                                        <span t-esc="d['name']"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td class="text-center">
                                                        <span>-</span>
                                                    </td>
                                                </t>
                                            </t>

                                            <t>
                                                <t t-if="d['due_date']">
                                                    <td class="text-center">
                                                        <span style="white-space: nowrap;"
                                                              t-esc="d['due_date'].strftime('%d-%m-%Y')"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td class="text-center">
                                                        <span>-</span>
                                                    </td>
                                                </t>
                                            </t>
                                            <t>
                                                <t t-if="d['partner']">
                                                    <td class="text-left">
                                                        <span t-esc="d['partner']"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td class="text-center">
                                                        <span>-</span>
                                                    </td>
                                                </t>
                                            </t>
                                            <t>
                                                <t t-if="d['amount']">
                                                    <td align="right">
                                                        <span t-esc="d['amount']"/>
                                                        <span t-esc="d['currency']"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td class="text-center">
                                                        <span>-</span>
                                                    </td>
                                                </t>
                                            </t>
                                            <t>
                                                <t t-if="d['check_number']">
                                                    <td class="text-center">
                                                        <span t-esc="d['check_number']"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td class="text-center">
                                                        <span>-</span>
                                                    </td>
                                                </t>
                                            </t>
                                            <t>
                                                <t t-if="d['bank']">
                                                    <td class="text-left">
                                                        <span t-esc="d['bank']"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td class="text-center">
                                                        <span>-</span>
                                                    </td>
                                                </t>
                                            </t>
                                            <t>
                                                <t t-if="d['memo']">
                                                    <td class="text-left">
                                                        <span t-esc="d['memo']"/>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td class="text-center">
                                                        <span>-</span>
                                                    </td>
                                                </t>
                                            </t>
                                            <!--                                            <t>-->
                                            <!--                                                <t t-if="d['payment_date']">-->
                                            <!--                                                    <td class="text-left">-->
                                            <!--                                                        <span t-esc="d['payment_date']"/>-->
                                            <!--                                                    </td>-->
                                            <!--                                                </t>-->
                                            <!--                                                <t t-else="">-->
                                            <!--                                                    <td class="text-center">-->
                                            <!--                                                        <span>-</span>-->
                                            <!--                                                    </td>-->
                                            <!--                                                </t>-->
                                            <!--                                            </t>-->
                                            <t>
                                                <t t-if="d['payment_status'] == 'deposited'">
                                                    <td class="text-center">
                                                        <span>Deposited</span>
                                                    </td>
                                                </t>
                                                <t t-if="d['payment_status'] == 'registered'">
                                                    <td class="text-center">
                                                        <span>Registered</span>
                                                    </td>
                                                </t>
                                                <t t-if="d['payment_status'] == 'bounced'">
                                                    <td class="text-center">
                                                        <span>Bounced</span>
                                                    </td>
                                                </t>
                                                <t t-if="d['payment_status'] == 'returned'">
                                                    <td class="text-center">
                                                        <span>Returned</span>
                                                    </td>
                                                </t>
                                                <t t-if="d['payment_status'] == 'done'">
                                                    <td class="text-center">
                                                        <span>Cash Received</span>
                                                    </td>
                                                </t>
                                                <t t-if="d['payment_status'] == 'cancelled'">
                                                    <td class="text-center">
                                                        <span>Cancelled</span>
                                                    </td>
                                                </t>
                                                <t t-if="d['payment_status'] == 'completed'">
                                                    <td class="text-center">
                                                        <span>PDC Done</span>
                                                    </td>
                                                </t>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div class="footer" align="right" style="margin-top: 10px;">
                            <div class="col-xs-6 text-center">
                                Page
                                <span class="page"/>
                                of
                                <span class="topage"/>
                            </div>
                        </div>
                        <!--                        <div class="footer" align="right" style="margin-top: 10px;">-->
                        <!--                            <div class="col-xs-6 text-center" align="center">-->
                        <!--                                Page-->
                        <!--                                <span class="page"/>-->
                        <!--                                of-->
                        <!--                                <span class="topage"/>-->
                        <!--                                <span>&amp;nbsp;</span>-->
                        <!--                                <span>&amp;nbsp;</span>-->
                        <!--                                Print Date-->
                        <!--                                &amp;nbsp;-->
                        <!--                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/>-->
                        <!--                                <span>&amp;nbsp;</span>-->
                        <!--                                Print Time-->
                        <!--                                &amp;nbsp;-->
                        <!--                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%H:%M:%S')"/>-->
                        <!--                            </div>-->
                        <!--                        </div>-->
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
