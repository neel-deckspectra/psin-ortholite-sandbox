<odoo>
    <template id="template_pdc_cheque_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <br/>
                    <br/>
                    <div class="page"
                         style=" border: 2px solid #00A6FF;padding: 20px;box-shadow: 6px 10px #00A6FF;border-radius: 12px;font-size:30px;">
                        <style>
                            body, html {
                            height: 100%;
                            margin: 0;
                            font-family: Arial, Helvetica, sans-serif;
                            }
                            * {
                            box-sizing: border-box;
                            }
                            height: 100%;
                            background-position: center;
                            background-repeat: no-repeat;
                            background-size: cover;
                            }
                            .bg-text {
                            background-color: rgb(0,0,0);
                            background-color: rgba(0,0,0, 0.4);
                            color: white;
                            font-weight: bold;
                            border: 3px solid #f1f1f1;
                            position: absolute;
                            top: 50%;
                            left: 50%;
                            transform: translate(-50%, -50%);
                            z-index: 2;
                            width: 80%;
                            padding: 20px;
                            text-align: center;
                            }
                        </style>
                        <br/>
                        <div class="row">
                            <div class="col-10">
                                <strong class="px-2">Bank</strong>
                                <strong class="px-2">:</strong>
                                <span t-field="doc.journal_id.bank_id.name"/>
                            </div>
                            <div>
                                <span t-field="doc.cheque_reference"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-10">
                                <strong class="px-2">Bank IFSC Number</strong>
                                <strong class="px-2">:</strong>
                                <span t-field="doc.journal_id.bank_id.bic"/>
                            </div>
                        </div>
                        <br/>
                        <div class="row mt32 mb32">
                            <div class="col-auto mw-100 mb-2">
                                <strong class="px-2">Account Number</strong>
                                <strong class="px-2">:</strong>
                                <span t-field="doc.journal_id.bank_account_id.acc_number"/>
                            </div>
                            <div class="col-auto mw-100 mb-2">
                            </div>
                            <div class="col-auto mw-100 mb-2">
                                <strong>Date</strong>
                                <strong class="px-2">:</strong>
                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/>
                                <h1 style="color:black; border-top:1px solid black; margin-top:1px"/>
                            </div>
                        </div>
                        <br/>
                        <br/>
                        <br/>
                        <br/>
                        <div class="row">
                            <div class="col-8">
                                <span class="px-2"></span>
                                <strong>Pay Against this Cheque</strong>
                                <strong class="px-2">:</strong>
                                <span t-field="doc.partner_id.name"/>
                                <h1 style="color:black; border-top:1px solid black; margin-top:1px"/>
                            </div>
                            <span class="px-3"/>
                            <!--                            <div>-->
                            <!--                                <span class="px-2" t-field="res_company.currency_id.symbol"/>-->
                            <!--                            </div>-->
                            <div class="col-2"
                                 style=" border-spacing: 1em 0.5em; padding: 0 2em 1em 0; border: 1px solid black;border-radius:2px;text-align: center;">
                                <span t-field="doc.amount"
                                      style="width: 1.5em;height: 1.5em;text-align: center;vertical-align:middle;"/>
                            </div>
                        </div>
                        <br/>
                        <div>
                            <span class="px-2"></span>
                            <strong>Amount In Words</strong>
                            <strong class="px-2">:</strong>
                            <span t-field="doc.check_amount_in_words"/>
                            <span class="px-1">Only</span>
                            <h1 style="color:black; border-top:1px solid black; margin-top:1px"/>
                        </div>
                        <br/>
                        <br/>
                        <div class="row">
                            <div class="col-5">
                                <span class="px-2"></span>
                                <strong>Memo</strong>
                                <strong class="px-2">:</strong>
                                <span t-field="doc.communication"/>
                                <h1 style="color:black; border-top:1px solid black; margin-top:1px"/>
                            </div>
                            <span class="px-2"></span>
                            <span class="px-2"></span>
                            <span class="px-2"></span>
                            <div class="col-6">
                                <span class="px-2"></span>
                                <br/>
                                <h1 style="color:black; border-top:1px solid black; margin-top:1px"/>
                            </div>
                        </div>
                        <br/>
                        <br/>
                        <div class="row">
                            <div class="col-6">
                            </div>
                            <div>
                                <strong>Signature</strong>
                                <strong class="px-2">__________________________</strong>
                            </div>
                            <div>
                                <h1 style="color:black; border-top:1px solid black; margin-top:1px"/>
                            </div>
                        </div>
                        <br/>
                        <br/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
