<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="pdc_payment_report_form">
            <field name="name">pdc.report.wizard</field>
            <field name="model">pdc.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Project">
                    <group>
                        <group colspan="2">
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                            <group>
                                <field name="user_id" widget="many2many_tags"/>
                                <field name="states"/>
                                <field name="current_user" invisible="1"/>
                            </group>
                        </group>
                    </group>
                    <footer>
                        <button name="print_pdc_report" string="Print Report"
                                type="object" default_focus="1" class="oe_highlight" icon="fa-print"/>
                        <button string="Cancel" class="btn-default" special="cancel" icon="fa-times"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_pdc_payment_report" model="ir.actions.act_window">
            <field name="name">PDC Payment Report</field>
            <field name="res_model">pdc.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem id="menu_pdc_payment_wizard"
                  name="PDC Payment Report "
                  action="action_pdc_payment_report"
                  parent="account.menu_finance_reports"
                  sequence="12"/>

    </data>
</odoo>
