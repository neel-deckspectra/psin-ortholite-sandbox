        <record id="sequence_pdc_customer" model="ir.sequence">
            <field name="name">Payments Customer PDC</field>
            <field name="code">account.payment.customer.pdc</field>
            <field name="prefix">CUST.PDC/%(range_year)s/</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="True" name="use_date_range"/>
            <field eval="False" name="company_id"/>
            <field name="padding">4</field>
        </record>
        <record id="sequence_pdc_supplier" model="ir.sequence">
            <field name="name">Payments Supplier PDC</field>
            <field name="code">account.payment.supplier.pdc</field>
            <field name="prefix">SUPP.PDC/%(range_year)s/</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="True" name="use_date_range"/>
            <field eval="False" name="company_id"/>
            <field name="padding">4</field>
        </record>

