<?xml version="1.0" encoding="utf-8"?>
    <odoo>

        <record id="view_move_form_inherit_ortholite" model="ir.ui.view">
            <field name="name">account.move.form.inherit.inherit.ortholite</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="attributes">
                    <attribute name="groups">ortholite_restrict_cost_visibility.group_cost_visibility</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="attributes">
                    <attribute name="groups">ortholite_restrict_cost_visibility.group_cost_visibility</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="attributes">
                    <attribute name="groups">ortholite_restrict_cost_visibility.group_cost_visibility</attribute>
                </xpath>
            </field>
        </record>

        <record id="account.menu_finance_entries" model="ir.ui.menu">
            <field name="groups_id" eval="[(5, 0),(4, ref('ortholite_restrict_cost_visibility.group_cost_visibility'))]"/>
        </record>

        <record id="account.menu_finance_reports" model="ir.ui.menu">
            <field name="groups_id" eval="[(5, 0),(4, ref('ortholite_restrict_cost_visibility.group_cost_visibility'))]"/>
        </record>

    </odoo>
